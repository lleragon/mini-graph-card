{
  "presets": [
    [
      "@babel/preset-env",
      {
        "targets": "baseline widely available"
      }
    ]
  ],
  "comments": false,
  "exclude": [
    "node_modules/**",
    "dist/**"
  ],
  "plugins": [
    [
      "@babel/plugin-proposal-decorators",
      {
        "version": "2023-11"
      }
    ]
  ]
}

{
  "name": "mini-graph-card",
  "version": "dev-1.0.1",
  "description": "A minimalistic and customizable graph card for Home Assistant Lovelace UI",
  "keywords": [
    "home-assistant",
    "homeassistant",
    "hass",
    "automation",
    "lovelace",
    "sensor",
    "graph",
    "svg",
    "custom-cards"
  ],
  "main": "src/main.js",
  "module": "src/main.js",
  "repository": "git@github.com:kalkih/mini-graph-card.git",
  "author": "Karl Kihlström <mrkihlstrom@gmail.com>",
  "license": "MIT",
  "dependencies": {

    "custom-card-helpers": "^1.9.0",
    "d3-interpolate": "^3.0.1",
    "lit-element": "^4.2.2",
    "localforage": "^1.10.0",
    "lz-string": "^1.5.0",
    "spark-md5": "^3.0.2"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.6",
    "@babel/core": "^7.29.0",
    "@babel/plugin-proposal-decorators": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@biomejs/biome": "2.4.4",
    "@rollup/plugin-babel": "^6.1.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.4",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/spark-md5": "^3.0.5",
    "rollup": "^4.58.0",
    "rollup-plugin-serve": "^3.0.0",
    "semantic-release": "^25.0.3",
    "@literals/rollup-plugin-html-css-minifier": "^3.0.1"
  },
  "scripts": {
    "build": "npm run lint && npm run rollup",
    "rollup": "rollup -c",
    "babel": "babel dist/mini-graph-card-bundle.js --out-file dist/mini-graph-card-bundle.js",
    "lint": "npx @biomejs/biome check --write",
    "watch": "rollup -c --watch",
    "postversion": "npm run build"
  }
}
